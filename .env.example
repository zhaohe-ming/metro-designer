# Frontend build-time API target.
# Set this in Vercel to your Render backend URL, for example:
# REACT_APP_API_BASE_URL=https://metro-designer-api.onrender.com
REACT_APP_API_BASE_URL=

# Backend allowed frontend origin.
# Set this in Render to your Vercel frontend URL, for example:
# FRONTEND_ORIGIN=https://metro-designer.vercel.app
FRONTEND_ORIGIN=

# Backend JWT signing secret.
# Set this in Render to a long random value.
JWT_SECRET=

# Backend database connection string.
# Set this in your backend host / Vercel environment after creating a Postgres database.
# When empty, the backend uses local server/data/db.json for development only.
DATABASE_URL=

# Optional. Set DB_SSL=false only for a local Postgres instance that does not use SSL.
DB_SSL=

# Frontend AMap JS API config.
# Create a Web JSAPI key in AMap Open Platform, then set both values in local .env.local and Vercel.
REACT_APP_AMAP_KEY=
REACT_APP_AMAP_SECURITY_CODE=

# Backend AMap Web Service key, used to proxy static map images for video export.
AMAP_WEB_SERVICE_KEY=

# Backend email sending (Resend). When empty, verification / reset emails are
# logged to the backend console instead of sent — useful for local dev.
RESEND_API_KEY=
# From-address for Resend. Use 'Metro Designer <onboarding@resend.dev>' until
# your own sending domain is verified on Resend.
EMAIL_FROM=
# Base URL used inside verification / reset emails. Set to your Vercel frontend
# URL in production so links resolve correctly. Falls back to FRONTEND_ORIGIN.
APP_BASE_URL=
