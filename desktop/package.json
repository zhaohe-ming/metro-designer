{
  "name": "transitcanvas-desktop",
  "version": "1.2.0",
  "description": "TransitCanvas 轨道工坊 Windows 客户端",
  "author": "TransitCanvas",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.cjs",
    "start": "node scripts/prepare-web.cjs && electron .",
    "start:fast": "electron .",
    "test": "node --test *.test.cjs",
    "dist": "node scripts/build-dist.cjs"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.metro-designer.desktop",
    "productName": "TransitCanvas",
    "artifactName": "TransitCanvas-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "../outputs/windows-app-v1.2.0"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "localProtocol.cjs",
      "projectIo.cjs",
      "updates.cjs",
      "policy.cjs",
      "offline.html",
      "web/**/*",
      "assets/icon.ico",
      "assets/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": "metro",
        "name": "TransitCanvas Project",
        "description": "TransitCanvas 轨道工坊工程文件",
        "icon": "assets/icon.ico"
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TransitCanvas",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zhaohe-ming",
        "repo": "metro-designer",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
